# EduLink Cloud Functions — environment template.
#
# Copy this file to `functions/.env` and fill in real values.
# `.env` is gitignored and MUST NEVER be committed.
# firebase-functions automatically loads `functions/.env` at deploy/emulator time.
#
# For higher-sensitivity secrets in production, prefer Firebase Secret Manager
# (`firebase functions:secrets:set NAME`) over plain .env — see PLAN.md Phase 7.

# RevenueCat webhook shared secret — verifies incoming webhook calls (Phase 7).
REVENUECAT_WEBHOOK_SECRET=

# Google Places API key (server-side) for placesAutocomplete/placeDetails →
# Places API (New). Application restriction: None; API: Places API (New); quota-capped.
PLACES_API_KEY=

# Resend — transactional + announcement email (admin panel).
# Create at resend.com, verify the eduLinky.com sending domain (SPF/DKIM).
RESEND_API_KEY=re_xxxxxxxxxxxx
# Replies go here. A GoDaddy forwarder to a real inbox is enough — no paid
# mailbox required, and it stops replies vanishing into the no-reply address.
MAIL_REPLY_TO=support@edulinky.com
MAIL_FROM=EduLinky <noreply@edulinky.com>
# Signs unsubscribe links so they cannot be forged. Any long random string:
#   openssl rand -hex 32
UNSUBSCRIBE_SECRET=replace-with-openssl-rand-hex-32
# Base URL the unsubscribe link points at (the deployed function host).
APP_URL=https://us-central1-edulinky-86123.cloudfunctions.net

# Admin panel base URL — used in the "new report" email so a moderator can
# jump straight to the queue. Set to the Render URL once deployed.
ADMIN_URL=https://admin.edulinky.com
